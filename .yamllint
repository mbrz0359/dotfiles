---
extends: default

rules:
  # CODE_STYLE.md: one blank line between tasks
  empty-lines:
    max: 1
  line-length: disable
  # Settings ansible-lint requires
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
