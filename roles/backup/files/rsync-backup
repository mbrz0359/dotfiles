#!/usr/bin/env bash
# Back up to the destinations defined in ~/.config/rsync-backup/config.sh.
#
#   rsync-backup            back up to every destination now
#   rsync-backup --if-due   skip once_a_day destinations backed up in the last
#                           20 hours (used by rsync-backup.timer, which runs hourly)
#
# The config is sourced and defines:
#   destinations    destination names, in run order; each is also an SSH host
#   skip_when_off   destinations to probe over SSH first, skipped if unreachable
#   once_a_day      destinations the 20-hour rule applies to
#   backup_<name>   a function per destination that calls run_rsync
set -uo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/rsync-backup/config.sh"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/rsync-backup"
max_age=$((20 * 60 * 60))

hostname=$(hostname)
destinations=()
skip_when_off=()
once_a_day=()
# shellcheck source=/dev/null
source "$config" || exit 1

if_due=false
[[ ${1:-} == --if-due ]] && if_due=true

# Records a failure without stopping, so the remaining rsyncs still run.
# rsync exits 24 when source files vanish mid-transfer, which is fine.
rsync_failed=false
run_rsync() {
  rsync "$@"
  local rc=$?
  ((rc == 0 || rc == 24)) || rsync_failed=true
}

contains() {
  local item
  for item in "${@:2}"; do
    [[ $item == "$1" ]] && return 0
  done
  return 1
}

backed_up_recently() {
  local stamp="$state_dir/$1"
  [[ -e $stamp ]] && (($(date +%s) - $(stat -c %Y "$stamp") < max_age))
}

mkdir -p "$state_dir"
failed=0

for dest in "${destinations[@]}"; do
  if $if_due && contains "$dest" "${once_a_day[@]}" && backed_up_recently "$dest"; then
    echo "$dest: backed up in the last 20 hours, skipping"
    continue
  fi
  if contains "$dest" "${skip_when_off[@]}" && ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$dest" true 2>/dev/null; then
    echo "$dest: unreachable, skipping"
    continue
  fi
  echo "$dest: backing up"
  rsync_failed=false
  "backup_$dest"
  if $rsync_failed; then
    echo "$dest: backup failed" >&2
    failed=1
  else
    touch "$state_dir/$dest"
  fi
done

exit $failed
