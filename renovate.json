{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "docker": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["ansible"],
      "groupName": "Ansible Docker Images"
    },
    {
      "description": "Merge non-major image updates without review; ayem applies them via ansible-pull",
      "matchManagers": ["ansible"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
