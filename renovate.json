{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "ansible"
      ],
      "groupName": "Ansible Docker Images"
    },
    {
      "description": "Merge non-major image updates once CI passes; ayem applies them via ansible-pull",
      "matchManagers": [
        "ansible"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Pinned CLI tools get a PR to review, never an automerge",
      "matchManagers": [
        "mise"
      ],
      "automerge": false
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "/(^|/)roles/cli-tools/files/cli-tools-[^/]+\\.toml$/"
    ]
  }
}
