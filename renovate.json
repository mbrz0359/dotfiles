{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "ansible"
      ],
      "groupName": "Ansible Docker Images"
    },
    {
      "description": "Merge non-major image updates once CI passes; ayem applies them via ansible-pull",
      "matchManagers": [
        "ansible"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Pinned CLI tools get a PR to review, never an automerge",
      "matchManagers": [
        "mise"
      ],
      "automerge": false
    },
    {
      "description": "Java is pinned to the LTS majors I need side by side, not to a version to keep current",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "java"
      ],
      "enabled": false
    },
    {
      "description": "flux2 stays on 2.6, which mise resolves to the latest patch",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "flux2"
      ],
      "allowedVersions": "<2.7"
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "/(^|/)roles/cli-tools/files/cli-tools-[^/]+\\.toml$/"
    ]
  }
}
