{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "ansible"
      ],
      "groupName": "Ansible Docker Images"
    },
    {
      "description": "Merge non-major image updates once CI passes; ayem applies them via ansible-pull",
      "matchManagers": [
        "ansible"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    }
  ]
}
